# ─────────────────────────────────────────────────────────────────────────────
# 봇 환경변수 템플릿
# ─────────────────────────────────────────────────────────────────────────────
# 로컬:   이 파일을 .env 로 복사해서 값을 채운다 (.gitignore 에 이미 포함)
# 배포:   Vercel → Project Settings → Environment Variables 에 같은 이름으로 등록
#
# 보안: 실제 키는 절대 커밋하지 않는다. VITE_ 접두사가 붙은 값은 브라우저에
#       그대로 노출되므로 비밀값에는 쓰지 않는다.
# ─────────────────────────────────────────────────────────────────────────────


# ─── 대화 백엔드 (루멘 / Open-WebUI) ─────────────────────────────────────────
# 구 미들턴 finbot 팀별 RAG 라우트는 2026-07 서버 재편으로 사라졌고,
# 현재는 Open-WebUI 의 OpenAI 호환 엔드포인트를 쓴다.
#   POST {LUMEN_BASE_URL}/api/chat/completions
# LUMEN_API_KEY 가 비면 채팅이 401 로 실패한다.

LUMEN_BASE_URL=https://middleton.o-r.kr
LUMEN_API_KEY=
LUMEN_MODEL=gemma4:latest

# 봇 성격. 비워두면 api/_persona.js 의 봇별 기본값을 쓴다.
BOT_SYSTEM_PROMPT=


# ─── 음성 인식 STT (루멘 whisper) ────────────────────────────────────────────
# 기본값이 LUMEN_BASE_URL 기준으로 잡히므로 보통 건드릴 필요 없다.

WHISPER_URL=
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# 봇 주제의 고유명사를 쉼표로 넣으면 인식률이 올라간다 (예: 분개,차변,대변)
WHISPER_PROMPT=


# ─── 음성 합성 TTS ───────────────────────────────────────────────────────────
# 루멘에는 현재 TTS(omnivoice) 라우트가 없다. 둘 다 비면 음성 없이
# 텍스트 대화만 동작한다 (에러 아님).
#   OMNI_URL       자체 TTS 서버가 생기면 그 주소
#   OPENAI_API_KEY OpenAI /v1/audio/speech 폴백

OMNI_URL=
OMNI_MODEL=omnivoice
OMNI_INSTRUCT=female, young adult, moderate pitch, korean accent

OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=shimmer


# ─── 학교 서버 (로그인 · 대화 로그 · 설문) ──────────────────────────────────
# api/school-api.js 가 aiforalab.com 으로 프록시한다. 팀 구분용 값이며
# 미설정 시 레거시 데이터로 기록된다.

TEAM_ID=
